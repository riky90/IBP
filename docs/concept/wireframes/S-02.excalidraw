   "versionNonce": 881982,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "States:\nempty — no cycle loaded: review strip hidden; message \"No cycle data yet.\" Pilot operator: primary button \"Import fixtures\" → S-09; others: \"Ask the pilot operator to load the fixtures.\"\nloading — skeleton cards\nerror — banner \"Couldn't read the cycle state\" with \"Retry\"\ncycle closed — strip reads \"Cycle 09 2026 closed · published as R and C on <date> · read-only\" with a link to the next cycle\nsuccess — as above",
   "originalText": "States:\nempty — no cycle loaded: review strip hidden; message \"No cycle data yet.\" Pilot operator: primary button \"Import fixtures\" → S-09; others: \"Ask the pilot operator to load the fixtures.\"\nloading — skeleton cards\nerror — banner \"Couldn't read the cycle state\" with \"Retry\"\ncycle closed — strip reads \"Cycle 09 2026 closed · published as R and C on <date> · read-only\" with a link to the next cycle\nsuccess — as above",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
