   "updated": 1,
   "link": null,
   "locked": false,
   "text": "States:\nempty — n/a\nloading — \"Checking the common plan…\" spinner, then \"Publishing…\"\nerror — \"Nothing published: <engine message>\" with \"Retry\"; \"The common plan changed during the review — refresh the check\" with \"Refresh\"\nsuccess — the dialog closes and S-22 opens with the written file; S-02 shows the cycle as \"Closed · published <date>\" with a lock icon",
   "originalText": "States:\nempty — n/a\nloading — \"Checking the common plan…\" spinner, then \"Publishing…\"\nerror — \"Nothing published: <engine message>\" with \"Retry\"; \"The common plan changed during the review — refresh the check\" with \"Refresh\"\nsuccess — the dialog closes and S-22 opens with the written file; S-02 shows the cycle as \"Closed · published <date>\" with a lock icon",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
