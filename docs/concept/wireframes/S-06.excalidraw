  {
   "id": "e156",
   "type": "text",
   "x": 0,
   "y": 920,
   "width": 2829.6,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 536783,
   "version": 1,
   "versionNonce": 331932,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "States:\nempty — \"No openings for this filter\"\nloading — skeleton\nerror — cell errors (\"Financial must be 0 or more\", \"FG not invoiced must be 0 or more\", \"Destination not valid for this plant\")\nread-only — banner with the server's reason (the pop-up stays available)\nsuccess — status bar counts update, and the inventory rows on S-04 and S-14 start from the opening used\nPlant view tab (not drawn): rows grouped by plant; plant header row shows \"Reported\" or \"Not reported — counts as 0\" (warning icon); under it one row per destination LE × region × planning model; columns \"FG not invoiced\" (input, 0 or more, \"i\"), \"Provenance\" (entered / mapped from plant × MK / fixture), \"Last change\"; per plant buttons \"Add destination row…\" and \"Report none for Aug 2026\".",
   "originalText": "States:\nempty — \"No openings for this filter\"\nloading — skeleton\nerror — cell errors (\"Financial must be 0 or more\", \"FG not invoiced must be 0 or more\", \"Destination not valid for this plant\")\nread-only — banner with the server's reason (the pop-up stays available)\nsuccess — status bar counts update, and the inventory rows on S-04 and S-14 start from the opening used\nPlant view tab (not drawn): rows grouped by plant; plant header row shows \"Reported\" or \"Not reported — counts as 0\" (warning icon); under it one row per destination LE × region × planning model; columns \"FG not invoiced\" (input, 0 or more, \"i\"), \"Provenance\" (entered / mapped from plant × MK / fixture), \"Last change\"; per plant buttons \"Add destination row…\" and \"Report none for Aug 2026\".",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
