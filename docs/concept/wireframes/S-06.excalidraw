   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e155",
   "type": "text",
   "x": 288,
   "y": 524,
   "width": 464.4,
   "height": 11.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
