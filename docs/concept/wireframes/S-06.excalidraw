   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Server decides: Total, the FGNI sum and Opening used, sign rules and the negative-fixture flag, the missing and not-reported counts, spread and mapping bases and their results, provenance,\nwhich view the role may write, the pop-up text (from the measure definitions, S-30q) and whether it opens automatically for this user.",
   "originalText": "Server decides: Total, the FGNI sum and Opening used, sign rules and the negative-fixture flag, the missing and not-reported counts, spread and mapping bases and their results, provenance,\nwhich view the role may write, the pop-up text (from the measure definitions, S-30q) and whether it opens automatically for this user.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
