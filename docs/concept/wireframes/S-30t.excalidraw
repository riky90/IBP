   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Validation (engine): sum to 100 % per exclusive group and scope; attach rate 0-100 %; region set must list every option (0 % allowed); global set required; plant not\nfound / not valid; 'new key \u00d7 plant pair' warning (saved); one routing group per MK; condition must be a routing option of the MK, only component groups carry one;\nduplicate rate set; component used by valid options. Audit: each rate row history shows source; overrides show the proposed value next to the saved one.",
   "originalText": "Validation (engine): sum to 100 % per exclusive group and scope; attach rate 0-100 %; region set must list every option (0 % allowed); global set required; plant not\nfound / not valid; 'new key \u00d7 plant pair' warning (saved); one routing group per MK; condition must be a routing option of the MK, only component groups carry one;\nduplicate rate set; component used by valid options. Audit: each rate row history shows source; overrides show the proposed value next to the saved one.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
