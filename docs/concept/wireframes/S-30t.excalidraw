   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "States - empty: 'No Planning BOM yet. Every manufacturing key is configurable; import the Planning BOM files or add groups by hand (U9). Until then no component\nrequirement is calculated.' with [Import\u2026] and [Download templates]. Key without a Planning BOM selected: '<MK> has no Planning BOM: no component requirement for this\nkey.' with [Add group]. Loading: skeleton panes. Error: validation messages (engine), or 'Not saved: engine error. Your input is kept.' with [Retry]. Success: 'Saved.\nComponent requirement recalculated: <n> cells changed' or 'Saved. Plant split recalculated' after a routing change.",
   "originalText": "States - empty: 'No Planning BOM yet. Every manufacturing key is configurable; import the Planning BOM files or add groups by hand (U9). Until then no component\nrequirement is calculated.' with [Import\u2026] and [Download templates]. Key without a Planning BOM selected: '<MK> has no Planning BOM: no component requirement for this\nkey.' with [Add group]. Loading: skeleton panes. Error: validation messages (engine), or 'Not saved: engine error. Your input is kept.' with [Retry]. Success: 'Saved.\nComponent requirement recalculated: <n> cells changed' or 'Saved. Plant split recalculated' after a routing change.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "s30t-93",
   "type": "text",
   "x": 0,
   "y": 1552.0,
   "width": 1386.0,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
