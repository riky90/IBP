   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rule or tier texts (engine): 'bridge 1:1', 'YCRANE N:1 by request %', 'CP-07 tier: routing group', 'tier: product master', 'tier: calibrated mix', 'tier: override',\n'frozen share - order book', '-BA two-step, 2-month offset', 'region group EMEA', 'global group', 'conditional on option red', 'rates only', 'ordered configuration'.\nProvenance: master data, order book, planner, override, manual exception, fixture.",
   "originalText": "Rule or tier texts (engine): 'bridge 1:1', 'YCRANE N:1 by request %', 'CP-07 tier: routing group', 'tier: product master', 'tier: calibrated mix', 'tier: override',\n'frozen share - order book', '-BA two-step, 2-month offset', 'region group EMEA', 'global group', 'conditional on option red', 'rates only', 'ordered configuration'.\nProvenance: master data, order book, planner, override, manual exception, fixture.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "s35-68",
   "type": "text",
   "x": 0,
